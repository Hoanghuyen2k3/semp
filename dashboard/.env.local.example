# Copy to .env.local and fill in your values
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Hugging Face (huggingface.co/settings/tokens) — Plant Health + dashboard chat
HUGGINGFACE_TOKEN=""
# Optional: chat model (default meta-llama/Meta-Llama-3-8B-Instruct — Llama 2 7B Chat has no HF serverless providers)
# HF_CHAT_MODEL=""
# Optional: force provider (auto uses your order at huggingface.co/settings/inference-providers), e.g. novita
# HF_CHAT_PROVIDER=""

# OpenWeather – 5-day forecast (openweathermap.org/api). Set coordinates for your garden.
OPENWEATHER_API_KEY=""
OPENWEATHER_LAT="43.6532"
OPENWEATHER_LON="-79.3832"
