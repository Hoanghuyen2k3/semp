# Copy to .env.local and fill in your values
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Plant Health AI (free Hugging Face token at huggingface.co/settings/tokens)
HUGGINGFACE_TOKEN=""

# OpenWeather – 5-day forecast (openweathermap.org/api). Set coordinates for your garden.
OPENWEATHER_API_KEY=""
OPENWEATHER_LAT="43.6532"
OPENWEATHER_LON="-79.3832"

# Google AI (Gemini) – AI assistant on the dashboard (aistudio.google.com/apikey)
GEMINI_API_KEY=""