# Copy to .env.local and fill in your values
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Hugging Face (huggingface.co/settings/tokens) — Plant Health + dashboard chat (Llama 2)
HUGGINGFACE_TOKEN=""
# Optional: override chat model (default meta-llama/Llama-2-7b-chat-hf; accept HF license for gated models)
# HF_CHAT_MODEL=""

# OpenWeather – 5-day forecast (openweathermap.org/api). Set coordinates for your garden.
OPENWEATHER_API_KEY=""
OPENWEATHER_LAT="43.6532"
OPENWEATHER_LON="-79.3832"
